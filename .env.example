# PostgreSQL da aplicação
POSTGRES_DB=analise_horas
POSTGRES_USER=analise_horas
POSTGRES_PASSWORD=troque-esta-senha

# Backend executado diretamente no Windows
DATABASE_URL=postgresql+psycopg://analise_horas:troque-esta-senha@127.0.0.1:5432/analise_horas

# Backend executado pelo Docker Compose
DOCKER_DATABASE_URL=postgresql+psycopg://analise_horas:troque-esta-senha@db:5432/analise_horas

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
IMPORT_SESSION_RETENTION_DAYS=7

# SQL Server / TFS
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=servidor-sql
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=banco-tfs

# Use "windows" para backend local com autenticação integrada.
# Use "sql" no contêiner e informe usuário/senha de somente leitura.
SQLSERVER_AUTH=windows
SQLSERVER_USER=
SQLSERVER_PASSWORD=

SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true
SQLSERVER_CONNECTION_TIMEOUT_SECONDS=10
SQLSERVER_REQUEST_TIMEOUT=60000

# Recuperação de operações de Indicadores Gerais que ficaram sem trabalhador ativo.
GENERAL_INDICATOR_PROCESSING_TIMEOUT_SECONDS=900

# Identificador opcional persistido nos snapshots oficiais.
BACKEND_BUILD_IDENTIFIER=
