{
  "name": "analise-horas-tfs-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:review-criteria": "node --experimental-strip-types --test tests/classificationReviewCriteria.test.mjs",
    "test:general-indicators": "node --experimental-strip-types --test tests/generalIndicatorState.test.mjs",
    "test:distribution-weights": "node --experimental-strip-types --test tests/distributionWeights.test.mjs",
    "test:navigation": "node --experimental-strip-types --test tests/navigationState.test.mjs",
    "test:report-history": "node --experimental-strip-types --test tests/reportHistory.test.mjs",
    "test:period-analysis": "node --experimental-strip-types --test tests/reportPeriodAnalysis.test.mjs",
    "test:period-comparison": "node --experimental-strip-types --test tests/reportPeriodComparison.test.mjs",
    "test:indicator-modules": "node --experimental-strip-types --test tests/generalIndicatorModules.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "rollup": "npm:@rollup/wasm-node@^4.62.2",
    "typescript": "^5.7.2"
  }
}
